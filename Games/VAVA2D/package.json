{
  "name": "vava2d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace @vava/server",
    "dev:client": "npm run dev --workspace @vava/client",
    "build": "npm run build --workspace @vava/client",
    "start": "npm run start --workspace @vava/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:shared && npm run test:server",
    "test:shared": "npm run test --workspace @vava/shared",
    "test:server": "npm run test --workspace @vava/server"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
